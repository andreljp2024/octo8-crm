rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // AVISO: Regras abertas temporariamente para a Fase 2 (Migração de Dados Real-time)
    // Na Opção A (Autenticação), voltaremos as regras de validação de Tenant.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

