rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para verificar se o perfil do usuário existe
    function hasUserProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Função auxiliar para verificar o tenantId do usuário atual
    function getUserTenantId() {
      return hasUserProfile() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId : null;
    }

    // Função para verificar se o usuário pertence ao tenant do documento
    function isFromTenant(tenantId) {
      return isAuthenticated() && (getUserTenantId() == null || getUserTenantId() == tenantId);
    }
    
    // Coleção Tenants
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    // Coleção Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        (resource != null && 'tenantId' in resource.data && isFromTenant(resource.data.tenantId))
      );
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regras Multitenant genéricas para coleções de negócio (calls, conversations, messages, opportunities, customers)
    match /{collection}/{document=**} {
      allow read: if isAuthenticated() && (
        resource == null || 
        !('tenantId' in resource.data) || 
        isFromTenant(resource.data.tenantId)
      );
      allow write: if isAuthenticated() && (
        request.resource == null || 
        !('tenantId' in request.resource.data) || 
        isFromTenant(request.resource.data.tenantId)
      );
    }
  }
}

